entity TradeShop{
	/** категория */
	category String,
	/** ценовой диапозон*/
	priceDiapozon Double,
	/** текущая цена */
	currentPrice Double,
	/** место- какая строка из пяти */
	whiceLineFromAllCountLines Long,
	/** айди текущего победителя*/
	tgUserIdWinner Long,
	/** дата размещения*/
	inWhatDateWillPostThisLinks Long,
	/** дата окончания торгов */
	dateFinishTorgs ZonedDateTime,
	/** удаленный*/
	isDelete Boolean,
	date1 ZonedDateTime,
	date2 ZonedDateTime,
	long1 Long,
	string1 String,
	boolean1 Boolean

}

