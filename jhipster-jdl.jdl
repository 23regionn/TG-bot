
entity TGUser{
    	idTgUser Long,			
    	firstName String,
    	registrationDate ZonedDateTime,
    	userRole String,
	isAdmin Boolean,
	score Double,
	isBlocked Boolean,
	chatId Long,
	/** удаленный*/
	isDelete Boolean,
	date1 ZonedDateTime,
	date2 ZonedDateTime,
	long1 Long,
	string1 String,
	boolean1 Boolean

}

entity TGUserLog{
    	idTgUser Long,			
    	firstName String,
    	registrationDate ZonedDateTime,
    	userRole String,
	isAdmin Boolean,
	score Double,
	isBlocked Boolean,
	chatId Long,
	/** удаленный*/
	isDelete Boolean,
	date1 ZonedDateTime,
	date2 ZonedDateTime,
	long1 Long,
	string1 String,
	boolean1 Boolean

}


entity Category{
	name String,
	countChanellInCategory Long,
	/** удаленный*/
	isDelete Boolean,
	date1 ZonedDateTime,
	date2 ZonedDateTime,
	long1 Long,
	string1 String,
	boolean1 Boolean
}

entity CategoryLog{
	name String,
	countChanellInCategory Long,
	/** удаленный*/
	isDelete Boolean,
	date1 ZonedDateTime,
	date2 ZonedDateTime,
	long1 Long,
	string1 String,
	boolean1 Boolean
}


entity Chanell{
	name String,
	link String,
	score Double,
	status String,
	countSubscribers Long,
	quailityFromAnotherSources Double,
	priceDiapozon Double,
	isModerate Boolean,
	showChanellInTopByCategory Boolean,
	region String,
	city String,
	/** удаленный*/
	isDelete Boolean,
	/** текущая дата*/
	currentDate ZonedDateTime,
	date1 ZonedDateTime,
	date2 ZonedDateTime,
	long1 Long,
	string1 String,
	boolean1 Boolean
}

entity ChanellLog{
	name String,
	link String,
	score Double,
	status String,
	countSubscribers Long,
	quailityFromAnotherSources Double,
	priceDiapozon Double,
	isModerate Boolean,
	showChanellInTopByCategory Boolean,
	region String,
	city String,
	/** удаленный*/
	isDelete Boolean,
	/** текущая дата*/
	currentDate ZonedDateTime,
	date1 ZonedDateTime,
	date2 ZonedDateTime,
	long1 Long,
	string1 String,
	boolean1 Boolean
}



entity Review{
	/** отзыв активен или не активен = прошел или не прошел*/
	isActive Boolean, 
	/** текст отзыва */
	text String,
	/** айди пользователя который написал */
	userId Long,
	/** ссылка на канал продавца рекламы от пользователя*/
	linkToSaller String,
	/** ссылка на админа, который пропустил отзыв  */
	adminId Long,
	/** отзыв положительный или негативный*/
	isNegative Boolean
	/** удаленный*/
	isDelete Boolean,
	date1 ZonedDateTime,
	date2 ZonedDateTime,
	long1 Long,
	string1 String,
	boolean1 Boolean

}

entity OfferFromCostumers{
	/** текст предложения, обратная связь*/
	text String, 
	/** удаленный*/
	isDelete Boolean,
	/** ссылка на админа, который пропустил отзыв  */
	adminId Long,
	/** предложение = обработали или нет */
	isActive Boolean,
	date1 ZonedDateTime,
	date2 ZonedDateTime,
	long1 Long,
	string1 String,
	boolean1 Boolean
}

entity OfferFromCostumersLog{
	/** текст предложения, обратная связь*/
	text String, 
	/** удаленный*/
	isDelete Boolean,
	/** ссылка на админа, который пропустил отзыв  */
	adminId Long,
	/** предложение = обработали или нет */
	isActive Boolean,
	date1 ZonedDateTime,
	date2 ZonedDateTime,
	long1 Long,
	string1 String,
	boolean1 Boolean
}


entity Pays{
	/** дата оплаты подписки*/	
	datePaysSubscriptions ZonedDateTime,
	/** за какой канал он оплатил, за ссылку на какой канал*/
	link String,
	/** сумма оплаты*/
	sumForPays Double,
	/** тип покупки*/
	typeBuy String,
	/** категория */
	category String,
	/** тип покупки long*/
	typeBuyLong Long,
	date1 ZonedDateTime,
	date2 ZonedDateTime,
	long1 Long,
	string1 String,
	boolean1 Boolean
}

entity LinksByCategoryInTop{
	/** категория */
	category String,
	/** ценовой диапозон*/
	priceDiapozon Double,
	/** ссылку на канал*/
