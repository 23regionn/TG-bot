entity Balance{
	balace Double,
	userId Long,
	/** сумма заморозки для торгов*/
	frostSum Double,
	dateLastAddBalance ZonedDateTime,
	dateLastMinusFromBalance ZonedDateTime,
	date1 ZonedDateTime,
	date2 ZonedDateTime,
	long1 Long,
	string1 String,
	boolean1 Boolean
}

entity BalanceLog{
	balace Double,
	userId Long,
	/** сумма заморозки для торгов*/
	frostSum Double,
	dateLastAddBalance ZonedDateTime,
	dateLastMinusFromBalance ZonedDateTime,
	date1 ZonedDateTime,
	date2 ZonedDateTime,
	long1 Long,
	string1 String,
	boolean1 Boolean
}


entity ConfigTable{

	dateOne ZonedDateTime,
	dateTwo ZonedDateTime,
	longOne Long,
	stringOne String,
	booleanOne Boolean,
	booleanTwo Boolean,
	date1 ZonedDateTime,
	date2 ZonedDateTime,
	long1 Long,
	string1 String,
	boolean1 Boolean
}


relationship OneToMany {
	TGUser to Chanell,
	TGUser to OfferFromCostumers,
	TGUser to Review,
	TGUser to Pays,
	Chanell to LinksByCategoryInTop,
	TradeShop to MembersTradeDeal,
	TGUser to TGUserLog,
	Chanell to ChanellLog,
	Category to CategoryLog,
	Balance to BalanceLog,
	MembersTradeDeal to MembersTradeDealLog,
	TradeShop to TradeShopLog,
	LinksByCategoryInTop to LinksByCategoryInTopLog,
	OfferFromCostumers to OfferFromCostumersLog	
}

relationship OneToOne {
	TGUser to Balance
}

relationship ManyToMany {
  Category{chanellId} to Chanell{categoryId},
  Category{linksByCategoryInTopId} to 	LinksByCategoryInTop{categoryId}
}











