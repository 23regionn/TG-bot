	/** ссылка на админа*/
	chanellAdminId 	Long,
	/** дата размещения ссылки */
    	datePostLinkStart ZonedDateTime,
	/** дата окончания размещения */
    	datePostLinkEnd ZonedDateTime,
	/** место среди ссылок */
	positionBetweenLinks Long,
	showLink Boolean,
	/** удаленный*/
	isDelete Boolean,
	date1 ZonedDateTime,
	date2 ZonedDateTime,
	long1 Long,
	string1 String,
	boolean1 Boolean

}

