	countsSubscriberAfter Long;
	chanellSallesId Long; 
	chanellBuierId Long; 
	userSallesId Long;
	userBuyerId Long;
	dateDeal ZonedDateTime,
	priceDeal BigDecimal,
	lifeTimePost Long, // время жизни поста
}


entity PostForAdFromSales{ // пост для рекламы от продавца
	// связь с объявлением многий ко одному
	lengthLifePostAd Double, // длина жизни поста
	placementTime Double, //время размещения
	
	commentToPost String, //комментарий к посту
	requirementsToPosts String, // требования к посту
}

entity Ad{ // Объявление - обвёртка над постами
	// свзяь с постами один ко многим
	price Double,
	name String,
	number Long,
	stopCategories String, // стоп категории
	comment String, // комментарий
	decription String // описание
	// связь с каналом многий к одному
	 
	
}


