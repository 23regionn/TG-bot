            <column name="comment" type="string"/>
            <column name="contacts" type="string"/>
            <column name="end_public_date" type="${datetimeType}"/>
            <column name="id_channel" type="numeric"/>
            <column name="is_moderate" type="boolean"/>
            <column name="is_pay" type="boolean"/>
            <column name="last_pay_date" type="${datetimeType}"/>
            <column name="link" type="string"/>
            <column name="name_channel" type="string"/>
            <column name="price_for_pay" type="string"/>
            <column name="start_date" type="${datetimeType}"/>
            <column name="count_subscribers" type="numeric"/>
            <column name="count_views" type="numeric"/>
            <column name="old_comment" type="string"/>
            <column name="old_contacts" type="string"/>
            <column name="old_end_public_date" type="${datetimeType}"/>
            <column name="old_is_moderate" type="boolean"/>
            <column name="old_is_pay" type="boolean"/>
            <column name="old_last_pay_date" type="${datetimeType}"/>
            <column name="old_link" type="string"/>
            <column name="old_name_channel" type="string"/>
            <column name="old_price_for_pay" type="string"/>
            <column name="old_start_date" type="${datetimeType}"/>
            <column name="old_count_subscribers" type="numeric"/>
            <column name="old_count_views" type="numeric"/>
            <!-- jhipster-needle-liquibase-add-loadcolumn - JHipster (and/or extensions) can add load columns here -->
        </loadData>
    </changeSet>
</databaseChangeLog>
