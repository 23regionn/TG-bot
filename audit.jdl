
entity ShowChannelsInCategoryLog{
	idChannel Long,
	nameChannel String,
	idCategory Long,
	nameCategory String,
	isShowChannel Boolean,
	scoreChannel Double,
	comment String,
	oldIsShowChannel Boolean,
	oldScoreChannel Double,
	oldComment String,
    dateLog LocalDate
}

entity ShowChannelsInCityLog{
	idChannel Long,
	nameChannel String,
	idCategory Long,
	nameCategory String,
	idCity Long,
	nameCity String,
	isShowChannel Boolean,
	scoreChannel Double,
	comment String,
	oldIsShowChannel Boolean,
	oldScoreChannel Double,
	oldComment String,
    dateLog LocalDate
}

entity AuditChannelsLog{
    dateLog LocalDate,
	comment String,
	contacts String,
	endPublicDate ZonedDateTime,
	idChannel Long,
	isModerate Boolean,
	isPay Boolean,
	lastPayDate ZonedDateTime,
	link String,
	nameChannel String,
	priceForPay String,
	startDate ZonedDateTime,
	countSubscribers Long,
	countViews Long,
	oldComment String,
	oldContacts String,
	oldEndPublicDate ZonedDateTime,
	oldIsModerate Boolean,
	oldIsPay Boolean,
	oldLastPayDate ZonedDateTime,
	oldLink String,
	oldNameChannel String,
	oldPriceForPay String,
	oldStartDate ZonedDateTime,
	oldCountSubscribers Long,
	oldCountViews Long
}
